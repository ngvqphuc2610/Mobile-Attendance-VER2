<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.mobile_attendance"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ===== Quyền cơ bản ===== -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Camera / QR / Face detection -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Micro nếu quay video/scan có audio -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Lưu/đọc file (scoped storage vẫn OK; chỉ cần nếu bạn thật sự ghi ra public storage) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32"/>
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29"
        tools:replace="android:maxSdkVersion" />

    <!-- ===== Location (cập nhật địa chỉ) ===== -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Nếu cần cập nhật vị trí trong nền (không bắt buộc, chỉ bật khi thực sự cần) -->
    <!-- <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" /> -->

    <!-- Foreground service cho tracking vị trí (nếu cần service chạy nền) -->
    <!-- Chỉ cần nếu bạn chạy foreground service để lấy location liên tục -->
    <!-- <uses-permission android:name="android.permission.FOREGROUND_SERVICE" /> -->
    <!-- <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" /> -->

    <!-- ===== Notifications (Android 13+) ===== -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- ===== Local Auth (vân tay/face) ===== -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Cho thiết bị Android cũ hơn -->
    <uses-permission android:name="android.permission.USE_FINGERPRINT" android:maxSdkVersion="28" />

    <!-- Thiết bị có camera (không bắt buộc tuyệt đối để vẫn cài trên thiết bị không có camera) -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <!-- Thiết bị có cảm biến vân tay -->
    <uses-feature android:name="android.hardware.fingerprint" android:required="false"/>
    <application
        android:label="mobile_attendance"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="false">

        <!-- Main Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <!-- Theme hiển thị trong lúc Flutter khởi động -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- ML Kit: tải trước model Face Detection (giảm độ trễ lần đầu) -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="face-detection" />

        <!-- Flutter embedding -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- FileProvider (chỉ cần nếu bạn chụp ảnh ra file và share URI ra ngoài app) -->
        <!--
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        -->
    </application>

    <!-- Package visibility (sẵn từ Flutter) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
